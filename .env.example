APP_NAME="FastAPI Boilerplate"
APP_VERSION="1.0.0"
APP_ENV=development
APP_DEBUG=True
APP_SECRET_KEY=your-secret-key-change-this

# Database
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=user
DB_PASSWORD=password

# Redis
REDIS_HOST = "localhost"
REDIS_PORT = 6379
REDIS_DB = 0

# SSL Mode (disable para dev/local, require para produção)
DB_SSLMODE=disable

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
